{
  // one flat config for the whole repo (app code, config files, tests, e2e) so that a bare
  // `tsc --noEmit` — the CI gate — actually type-checks everything instead of doing nothing, which
  // is what a project-references "solution" tsconfig (files: [], references: [...]) does unless run
  // with `-b`. src/ needs DOM; vite.config.ts/playwright.config.ts/scripts/tests need Node — both
  // lib sets are included together since this is a small single app, not a multi-package repo.
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["svelte", "vite/client", "node", "@playwright/test"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    // `@instance` is a Vite alias for instances/<VITE_INSTANCE>/ (vite.config.ts); the type checker
    // reads the default instance, and src/lib/brand/instance.ts types the JSON by its own interface.
    "paths": { "@instance/*": ["./instances/oceanmetrics/*"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.d.ts",
    "*.config.ts"
  ],
  // belt-and-suspenders on top of "include" already being a strict allowlist: the four S1-S4
  // spike worktrees (each with its own package.json/tsconfig/Playwright specs, landing via
  // parallel merges) and the worktrees themselves must never be pulled into the root `tsc
  // --noEmit` gate.
  "exclude": ["spikes", ".claude", "node_modules", "dist"]
}
