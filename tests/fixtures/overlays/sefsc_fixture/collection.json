  "id": "sefsc_fixture",
  "title": "SEFSC Gulf of America marine mammals (fixture)",
  "description": "A tiny synthetic stand-in for an unlisted, versioned hex-valued density collection with its own vector overlays (atlas:overlays): vessel sightings over vessel effort over the model hexagons.",
  "version": "2",
  "license": "CC-BY-4.0",
  "sci:citation": "Garrison, L.P. et al. (fixture). Synthetic citation.",
  "contacts": [
    {
      "name": "Pat Provider",
      "organization": "NOAA SEFSC (fixture)",
      "roles": ["principal investigator"]
    }
  ],
  "providers": [
    {
      "name": "NOAA SEFSC (fixture)",
      "roles": ["producer"]
    },
    {
      "name": "OceanMetrics",
      "roles": ["processor", "host"],
      "url": "https://oceanmetrics.io"
    }
  ],
  "sdm:response_type": "abundance",
  "sdm:value_unit": "unitless",
  "extent": {
    "spatial": {
      "bbox": [[-90.2, 27.0, -88.9, 28.0]]
    },
    "temporal": {
      "interval": [["2003-01-01T00:00:00Z", "2024-12-31T00:00:00Z"]]
    }
  },
