    "species": {
      "type": "other",
      "title": "Species",
      "values": ["rices_whale", "bottlenose_dolphin", "sperm_whale"],
      "atlas:labels": {
        "rices_whale": "Rice's whale",
        "bottlenose_dolphin": "Common bottlenose dolphin",
        "sperm_whale": "Sperm whale"
      },
      "atlas:taxon_dim": true
    }
  },
  "atlas:overlays": [
    {
      "id": "sightings_vessel",
      "title": "Vessel sightings, 2003–2024",
      "asset": "sightings_vessel",
      "source_layer": "sightings_vessel",
      "geometry": "point",
      "color": "#c51b7d",
      "default": true,
      "label_field": "vernacularName",
      "fields": [
        "sightid",
        "date",
        "survey",
        "vernacularName",
        "scientificName",
        "group.size",
        "beaufort",
        "lat",
        "lon",
        "models",
        "comments"
      ],
      "field_labels": {
        "group.size": "Group size",
        "vernacularName": "Common name",
        "scientificName": "Scientific name"
      },
      "filter_field": "models"
    },
    {
      "id": "effort_vessel",
      "title": "Vessel effort, 2003–2024",
      "asset": "effort_vessel",
      "source_layer": "effort_vessel",
      "geometry": "line",
      "color": "#2c7fb8",
      "default": true,
      "label_field": "platform",
      "fields": ["segid", "survey", "date", "effort_km", "beaufort", "platform"],
      "field_labels": {
        "effort_km": "Effort (km)"
      }
    },
    {
      "id": "hexagons",
      "title": "Model hexagons (40 km²)",
      "asset": "hexagons",
      "source_layer": "hexagons",
      "geometry": "polygon",
      "color": "#636363",
      "default": false,
      "label_field": "hex_id",
      "filter_field": "models"
    }
  ],
  "assets": {
    "hex": {
      "href": "./hex.pmtiles",
      "type": "application/vnd.pmtiles",
      "roles": ["data"],
      "pmtiles:layers": ["hex"],
      "atlas:id_field": "FID"
    },
    "values": {
      "href": "./values.parquet",
      "type": "application/vnd.apache.parquet",
      "roles": ["data"],
      "atlas:key_column": "FID"
    },
    "sightings_vessel": {
      "href": "./overlays/sightings_vessel.pmtiles",
      "type": "application/vnd.pmtiles",
      "roles": ["data"],
      "title": "Vessel sightings",
      "pmtiles:layers": ["sightings_vessel"]
    },
    "effort_vessel": {
      "href": "./overlays/effort_vessel.pmtiles",
