    {
      "name": "h3",
      "type": "VARCHAR",
      "description": "H3 cell index as a lowercase hex string (deck.gl H3HexagonLayer getHexagon)"
    },
    {
      "name": "cell_id",
      "type": "BIGINT",
      "description": "H3 cell index as BIGINT (same cell as h3)"
    },
    {
      "name": "n",
      "type": "BIGINT",
      "description": "number of occurrence records"
    },
    {
      "name": "sp",
      "type": "BIGINT",
      "description": "species richness (distinct species names)"
    },
    {
      "name": "shannon",
      "type": "DOUBLE",
      "description": "Shannon diversity H' = -sum(p_i ln p_i) over species"
    },
    {
      "name": "simpson",
      "type": "DOUBLE",
      "description": "Simpson index sum(p_i^2) over species"
    },
    {
      "name": "es",
      "type": "DOUBLE",
      "description": "Hurlbert expected number of species in a random draw of 50 records, ES(50); NULL where n < 50"
    }
  ],
