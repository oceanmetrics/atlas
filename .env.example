# the atlas instance to build (instances/<id>/, see README "Instances"); default `oceanmetrics`.
# scripts/*.mjs (contrast, check-hex-literals, export-tokens, render-og, ...) read the same variable
# from the process environment. The MarineSensitivity seal flags (VITE_SEAL, VITE_AGENCY,
# VITE_SEAL_URL) belong to that instance and return with it (instances/marinesensitivity/README.md).
# VITE_INSTANCE=oceanmetrics

# atlas-8 Deliverable 4 (docs/feedback.md): left unset, "Report a problem" opens a prefilled GitHub
# issue directly (zero backend). Set to an Apps Script (or similar) /exec endpoint to have the
# control POST the same context there instead, falling back to the GitHub link on any failure.
# VITE_FEEDBACK_URL=https://script.google.com/macros/s/.../exec
